{
  "openapi": "3.1.0",
  "info": {
    "title": "Desk Flow API",
    "version": "1.0.0",
    "description": "-"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Input the JWT from /api/v1/auth/login"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["ADMIN", "CASHIER"] },
          "creditHours": { "type": "number" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updateAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "member@gmail.com" },
                  "password": { "type": "string", "example": "member123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login Success"
          },
          "401": { "description": "Email or password is incorrect" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "name": { "type": "string", "example": "example name" },
                  "email": { "type": "string", "example": "example@gmail.com" },
                  "password": { "type": "string", "example": "example123" },
                  "role": { "type": "string", "example": "USER" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil dan mengembalikan token JWT"
          },
          "401": { "description": "Email atau password salah" }
        }
      }
    }
  }
}

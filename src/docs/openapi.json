{
  "openapi": "3.1.0",
  "info": {
    "title": "Desk Flow API",
    "version": "1.0.0",
    "description": "-"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Input the JWT from /api/v1/auth/login"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "cm1usr0000008l0g9hk3xyz" },
          "name": { "type": "string", "example": "John Doe" },
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "role": {
            "type": "string",
            "enum": ["ADMIN", "MEMBER"],
            "example": "MEMBER"
          },
          "creditHours": { "type": "number", "example": 10.0 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "cm1abcdef000008l0g9hk3xyz" },
          "code": { "type": "string", "example": "RM-MAIN-01" },
          "name": { "type": "string", "example": "Executive Meeting Room" },
          "type": {
            "type": "string",
            "enum": ["MEETING_ROOM", "HOT_DESK", "PODCAST_STUDIO"],
            "example": "MEETING_ROOM"
          },
          "capacity": { "type": "integer", "example": 12 },
          "hourlyRate": { "type": "number", "example": 150000 },
          "creditRatePerHour": { "type": "number", "example": 2.0 },
          "isActive": { "type": "boolean", "example": true },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-29T08:00:00.000Z"
          }
        }
      },
      "CreateRoomRequest": {
        "type": "object",
        "required": ["code", "name", "type", "capacity", "hourlyRate"],
        "properties": {
          "code": { "type": "string", "example": "RM-MAIN-01" },
          "name": { "type": "string", "example": "Executive Meeting Room" },
          "type": {
            "type": "string",
            "enum": ["MEETING_ROOM", "HOT_DESK", "PODCAST_STUDIO"],
            "example": "MEETING_ROOM"
          },
          "capacity": { "type": "integer", "example": 12 },
          "hourlyRate": { "type": "number", "example": 150000 },
          "creditRatePerHour": {
            "type": "number",
            "default": 1.0,
            "example": 2.0
          },
          "isActive": { "type": "boolean", "default": true, "example": true }
        }
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "cm1bkg0000008l0g9hk3xyz" },
          "bookingNumber": { "type": "string", "example": "BKG-20260929-0001" },
          "userId": { "type": "string", "example": "cm1usr0000008l0g9hk3xyz" },
          "roomId": {
            "type": "string",
            "example": "cm1abcdef000008l0g9hk3xyz"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-30T09:00:00.000Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-30T11:00:00.000Z"
          },
          "totalHours": { "type": "number", "example": 2.0 },
          "creditsUsed": { "type": "number", "example": 4.0 },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "CHECKED_IN",
              "COMPLETED",
              "CANCELLED",
              "AUTO_RELEASED"
            ],
            "example": "CONFIRMED"
          },
          "checkInToken": {
            "type": ["string", "null"],
            "example": "a8f5f167f44f4964e6c998dee827110c"
          },
          "checkedInAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "example": null
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-29T08:30:00.000Z"
          },
          "user": { "$ref": "#/components/schemas/User" },
          "room": { "$ref": "#/components/schemas/Room" }
        }
      },
      "CreateBookingRequest": {
        "type": "object",
        "required": ["roomId", "startTime", "endTime"],
        "properties": {
          "roomId": {
            "type": "string",
            "example": "cm1abcdef000008l0g9hk3xyz"
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-30T09:00:00.000Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-30T11:00:00.000Z"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "member@gmail.com" },
                  "password": { "type": "string", "example": "member123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login Success"
          },
          "401": { "description": "Email or password is incorrect" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "name": { "type": "string", "example": "example name" },
                  "email": { "type": "string", "example": "example@gmail.com" },
                  "password": { "type": "string", "example": "example123" },
                  "role": { "type": "string", "example": "USER" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil dan mengembalikan token JWT"
          },
          "401": { "description": "Email atau password salah" }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Get All",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "email", "in": "query", "schema": { "type": "string" } },
          {
            "name": "userId",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "List Users" } }
      }
    },
    "/api/v1/rooms": {
      "get": {
        "tags": ["Rooms"],
        "summary": "Get All",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          {
            "name": "roomId",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "List Rooms" } }
      }
    }
  }
}
